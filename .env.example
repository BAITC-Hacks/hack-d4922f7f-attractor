# Optional: copy to .env. Docker Compose reads it; direct Python does not.
# The default demo works without .env and without API keys.
AKIM_WEB_PORT=8080
AKIM_API_PORT=8000
# Used only by direct Python launch. Compose fixes this to the persistent volume.
AKIM_DATA_GATE_DIR=var/data-gate
AKIM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Configure a private token to enable administrative Data Gate HTTP endpoints.
AKIM_ADMIN_TOKEN=
# Offline by default. Set all three deliberately to enable paid LLM calls.
AKIM_LLM_ENABLED=0
OPENAI_API_KEY=
OPENAI_MODEL=
# Per process: 10 analyses, <=3 calls/analysis including repair, <=800 output tokens/call.
# This is a call/token cap, not a currency cap. Also configure a provider project budget.
AKIM_LLM_MAX_ANALYSES=10
